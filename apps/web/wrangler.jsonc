{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cairn-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // `nodejs_compat` is required by OpenNext, and the date above must be
  // 2024-09-23 or later for it to take effect.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    // On by default so a production incident has logs to read. Cloudflare
    // charges for retention beyond the free allowance; that is a smaller cost
    // than an outage nobody can explain.
    "enabled": true
  },
  "vars": {
    // The API lives on GCP (md/06 §1) — Cloudflare serves and routes, GCP
    // thinks. Overridden per environment; the default is local development.
    "NEXT_PUBLIC_API_URL": "http://localhost:8000"
  }
}
