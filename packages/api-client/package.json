{
  "name": "@cairn/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client \u2014 generated from the API's OpenAPI schema",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "node scripts/generate-client.mjs"
  },
  "devDependencies": {
    "@cairn/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "openapi-typescript": "catalog:"
  }
}
