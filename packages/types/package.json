{
  "name": "@cairn/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types \u2014 generated from the API OpenAPI schema, plus hand-written domain types",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "node scripts/generate-types.mjs"
  },
  "devDependencies": {
    "@cairn/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "json-schema-to-typescript": "catalog:"
  }
}
