# CAIRN configuration.
#
#   cp .env.example .env
#
# The values below are safe for local development and match docker-compose.yml.
# Nothing here may be used by an environment that holds customer data.
#
# See md/06-infrastructure.md §7 for how these are supplied in production.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# local | test | staging | production
#
# Read by migrations as well as the application.
#
# "local" and "test" are the non-deployed environments and may use the defaults
# below; "test" means the automated test run, not a deployed test server —
# pre-production deployments are "staging". Anything else makes both the
# migrations and the application refuse to start on a development default.
CAIRN_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The application connection. Must be a NOSUPERUSER, NOBYPASSRLS role, or every
# row-level security policy is silently inert — a startup preflight check
# refuses to boot if it is not (apps/api/src/cairn_api/db/preflight.py).
CAIRN_DATABASE_URL=postgresql+asyncpg://cairn_app:cairn_local_dev@localhost:5432/cairn

# The privileged connection, used only for operations that precede any tenant
# context: signup, workspace creation, invitation acceptance, and migrations.
#
# Must hold BYPASSRLS. Every table is FORCE ROW LEVEL SECURITY, so a role
# without it reads nothing at all — presenting as "no such user" for every
# account rather than as an error.
CAIRN_PLATFORM_DATABASE_URL=postgresql+asyncpg://cairn:cairn_local_dev@localhost:5432/cairn

# Echo SQL to the log. Never enable outside local development — it writes
# customer data into log storage.
CAIRN_DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Origins allowed to call the API with credentials. Comma-separated.
#
# Never '*': the browser refuses a wildcard alongside credentialed requests, and
# a service that responded with one would be inviting any page on the internet
# to act as a signed-in user. Startup refuses both '*' and http:// origins
# outside local development.
CAIRN_CORS_ALLOWED_ORIGINS=http://localhost:3000

# How many proxies append to X-Forwarded-For in front of this service.
#
# The client address is read that many entries from the right. Wrong in either
# direction breaks per-address rate limiting: too low reads a proxy's address
# and collapses every caller into one bucket, too high reads a client-supplied
# value and hands an attacker a fresh bucket per request.
#
# Cloud Run alone: 1. Behind an external HTTPS load balancer: 2.
CAIRN_TRUSTED_PROXY_HOPS=1

# Domain for the session cookie. Unset means host-only, which is correct
# locally. In production the API and the app are separate hosts under one site,
# so this becomes the registrable domain for the cookie to reach both.
# CAIRN_SESSION_COOKIE_DOMAIN=.cairn.dev

# ---------------------------------------------------------------------------
# GitHub App
# ---------------------------------------------------------------------------
# Shared secret registered with the GitHub App.
#
# REQUIRED outside local development. The webhook endpoint is the only
# unauthenticated write path in the service, so a blank secret makes it an open
# door that looks closed — startup refuses rather than accepting everything.
# CAIRN_GITHUB_WEBHOOK_SECRET=

# Numeric App ID and PEM private key. Required for backfill (Step 13), which
# calls back to GitHub; not needed to receive webhooks.
#
# The private key grants every customer's repositories for as long as nobody
# notices, so it is exchanged for short-lived per-installation tokens and never
# leaves cairn_api.github.auth.
# CAIRN_GITHUB_APP_ID=
# CAIRN_GITHUB_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Connector credentials
# ---------------------------------------------------------------------------
# Every value below is a credential. None of them belongs in this file, in a
# migration, in CI output or in a chat message — set them in the host's secret
# store, per environment. See infra/DECISIONS.md.

# The key that encrypts stored connector tokens at rest.
#
# REQUIRED outside local development. Without it the application falls back to
# a development key published in config.py, which means the tokens in that
# database are readable by anyone holding the source — a state the startup log
# says out loud rather than hides.
#
# 32 random bytes, base64-encoded. Rotating it re-encrypts nothing: existing
# tokens become unreadable and every connector has to be reconnected, so treat
# a rotation as a customer-visible event rather than a maintenance task.
# CAIRN_CONNECTOR_ENCRYPTION_KEY=

# Slack. See docs/runbooks/connectors.md for what each scope buys.
#
# The signing secret verifies inbound events; the client id and secret are the
# OAuth pair the install flow uses. The redirect URI must match Slack's app
# configuration exactly, including scheme and trailing path.
# CAIRN_SLACK_CLIENT_ID=
# CAIRN_SLACK_CLIENT_SECRET=
# CAIRN_SLACK_SIGNING_SECRET=
# CAIRN_SLACK_REDIRECT_URI=

# Google Chat.
#
# Chat delivers events over Pub/Sub rather than a plain webhook, so it needs a
# project, a topic and a service account in addition to the OAuth pair. The
# push audience is the value inbound JWTs are verified against — a mismatch
# rejects every delivery, which looks exactly like a workspace with no traffic.
# CAIRN_GOOGLE_CHAT_CLIENT_ID=
# CAIRN_GOOGLE_CHAT_CLIENT_SECRET=
# CAIRN_GOOGLE_CHAT_REDIRECT_URI=
# CAIRN_GOOGLE_CHAT_PROJECT_ID=
# CAIRN_GOOGLE_CHAT_PUBSUB_TOPIC=
# CAIRN_GOOGLE_CHAT_SERVICE_ACCOUNT=
# CAIRN_GOOGLE_CHAT_PUSH_AUDIENCE=

# Google Meet — the connection itself.
#
# meetings.space.readonly is a SENSITIVE scope: it needs OAuth verification but
# not an independent security assessment, so this half can be configured once
# verification is done.
# CAIRN_GOOGLE_MEET_CLIENT_ID=
# CAIRN_GOOGLE_MEET_CLIENT_SECRET=
# CAIRN_GOOGLE_MEET_REDIRECT_URI=
# CAIRN_GOOGLE_MEET_PROJECT_ID=
# CAIRN_GOOGLE_MEET_PUBSUB_TOPIC=
# CAIRN_GOOGLE_MEET_SERVICE_ACCOUNT=
# CAIRN_GOOGLE_MEET_PUSH_AUDIENCE=

# Google Meet — transcript retrieval, which is gated on a separate assessment.
#
# drive.meet.readonly is a RESTRICTED scope requiring an independent CASA
# security assessment ending in a Letter of Assessment. Leave these unset until
# that letter exists; the release gate says so too.
#
# A client of its own, deliberately. Sharing the connector's OAuth client would
# make each grant's scopes appear in the other's token response and break both.
# CAIRN_GOOGLE_MEET_TRANSCRIPT_CLIENT_ID=
# CAIRN_GOOGLE_MEET_TRANSCRIPT_CLIENT_SECRET=
# CAIRN_GOOGLE_MEET_TRANSCRIPT_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Queue fairness
# ---------------------------------------------------------------------------
# Run a deployed environment on a queue backend that cannot enforce per-tenant
# fairness or priority — that is, Pub/Sub.
#
# Default false, and it should stay false. On a backend without fairness one
# customer's 90-day backfill can occupy every worker and delay another
# customer's live push indefinitely. Setting this to true is a decision
# somebody writes down, which is why it is not simply inferred from the backend.
# CAIRN_QUEUE_FAIRNESS_OPTIONAL=false

# ---------------------------------------------------------------------------
# Model spend and retrieval budgets
# ---------------------------------------------------------------------------
# Per-tenant ceilings, enforced per process. They do not survive a restart and
# are not shared across replicas, so a tenant's real ceiling today is this
# number multiplied by the number of running processes — see infra/README.md.
# CAIRN_MODEL_MAX_TOKENS_PER_TENANT=
# CAIRN_MODEL_MAX_CALLS_PER_TENANT=

# How much context synthesis and retrieval may assemble.
#
# These bound cost and blast radius rather than quality: a larger budget lets
# one delivery pull more of the graph into one model call, which costs more and
# widens what a single crafted input can influence.
# CAIRN_SYNTHESIS_MAX_FACTS=
# CAIRN_RETRIEVAL_ENTRY_POINTS=
# CAIRN_RETRIEVAL_MAX_HOPS=
# CAIRN_RETRIEVAL_BUDGET_CHARS=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# console | smtp
#
# "console" writes each message to the log and sends nothing, so an invitation
# link can be copied out of a terminal. A deployed environment refuses to start
# on it: an invited colleague would never hear from us, and neither the request
# nor the invitation row would record that.
CAIRN_EMAIL_BACKEND=console

# Base URL of the web app, used to build the links in outbound email. Never
# derived from the request — a verification link built from an attacker-supplied
# Host header sends the token to the attacker.
CAIRN_PUBLIC_APP_URL=http://localhost:3000

# Sender, relay and credentials. CAIRN_SMTP_HOST is REQUIRED when the backend is
# "smtp"; the username and password are omitted for a relay authenticated by
# network. Startup refuses "smtp" without a host rather than warning once per
# undelivered message.
# CAIRN_EMAIL_FROM=CAIRN <no-reply@cairn.dev>
# CAIRN_SMTP_HOST=
# CAIRN_SMTP_PORT=587
# CAIRN_SMTP_USERNAME=
# CAIRN_SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Job queue
# ---------------------------------------------------------------------------
# memory | postgres | pubsub
#
# "memory" holds jobs in RAM and loses every one of them on restart, silently.
# It is right for local development and tests and nowhere else — a deployed
# environment refuses to start on it rather than defaulting quietly.
#
# "postgres" is the backend to deploy. It is the only one that enforces
# priority and per-tenant fairness, because it is the only one where every
# worker sees the same queue: a live push always outranks a backfill, and one
# customer's import cannot occupy every worker. See docs/OPERATIONS.md.
#
# "pubsub" is durable but delivers in arrival order only. Choosing it opts out
# of fair scheduling, and the worker says so at startup.
CAIRN_QUEUE_BACKEND=memory

# Required when CAIRN_QUEUE_BACKEND=pubsub. Never inferred from ambient
# credentials, which is how a staging worker ends up consuming production's
# queue.
# CAIRN_GCP_PROJECT_ID=

# Topic and subscription names. Defaults are fine unless several environments
# share one project.
# CAIRN_QUEUE_TOPIC=cairn-jobs
# CAIRN_QUEUE_SUBSCRIPTION=cairn-jobs-worker
# CAIRN_QUEUE_DEAD_LETTER_TOPIC=cairn-jobs-dead-letter

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------
# Which adapter the understanding pipeline calls.
#
# "auto" picks Vertex when CAIRN_GCP_PROJECT_ID is set and no model otherwise.
# "openai" is a real model behind an API key. "scripted" is the deterministic
# provider the evaluation harness grades against — right for local work, and a
# deployed environment refuses to start on it, because canned output is
# indistinguishable in the interface from something a model understood.
# CAIRN_MODEL_BACKEND=auto

# Required when CAIRN_MODEL_BACKEND=openai, and refused at boot without one in
# **every** environment including local. Unlike Vertex there is no ambient
# credential to fall back on: without a key every model call fails, and the
# pipeline produces empty briefs rather than an error anybody would see.
#
# Held as a secret, so it is redacted from the settings repr and cannot reach a
# log line or a traceback that way.
# CAIRN_OPENAI_API_KEY=

# The chat model, pinned rather than tracking an alias. An alias moves under a
# deployment that did not change: cost, latency and output quality would all
# shift on somebody else's release day, and the evaluation baseline would drift
# with no commit to point at.
# CAIRN_OPENAI_MODEL=gpt-4o-mini

# The embedding model, pinned for the same reason and more sharply: changing it
# invalidates every vector already stored, so this is part of the data's shape
# rather than a tuning knob.
# CAIRN_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set this to point the Pub/Sub client at the local emulator (make queue-up).
# Its presence is also what makes the adapter's tests run instead of skip.
# PUBSUB_EMULATOR_HOST=localhost:8085

# ---------------------------------------------------------------------------
# Migration-time only
# ---------------------------------------------------------------------------
# Password for the cairn_app role, set when migrations create or repair it.
#
# REQUIRED whenever CAIRN_ENVIRONMENT is not "local" — the migration raises
# rather than falling back, because an earlier version hardcoded the value below
# and would have created production roles with a credential published in this
# repository. Supply it from Secret Manager.
# CAIRN_APP_ROLE_PASSWORD=

# Which role receives BYPASSRLS. Defaults to the username in
# CAIRN_PLATFORM_DATABASE_URL, which is almost always what you want. Set this
# only if the two genuinely differ.
# CAIRN_PLATFORM_ROLE=

# ---------------------------------------------------------------------------
# Web application (apps/web)
# ---------------------------------------------------------------------------
# Everything below is read by Vite and INLINED INTO THE BROWSER BUNDLE at build
# time. None of it may ever hold a secret: a VITE_ variable is public the moment
# the app is served. That is the reason the session is an HttpOnly cookie the
# frontend cannot read rather than a token this layer would have to store.
#
# Origin of the API. The default matches `make serve`. It must appear in
# CAIRN_CORS_ALLOWED_ORIGINS' counterpart on the API side — that is, the web app
# must be served from an origin the API allows, or the CSRF origin check rejects
# every sign-in with a 403 that looks like nothing happening at all.
#
# The dev server is pinned to port 3000 (apps/web/vite.config.ts) for exactly
# that reason.
VITE_CAIRN_API_URL=http://localhost:8000

# api | sample
#
# Where the Brief and Feed screens read from. `api` calls the real endpoints.
# `sample` renders a fixed example so those screens can be designed and reviewed
# before `GET /v1/workspaces/{id}/brief` and `/facts` exist.
#
# `api` is the default deliberately, and `sample` shows an undismissable banner
# on every screen it affects. A product whose promise is "every claim links to
# its source" must never be able to show invented claims without saying so.
VITE_CAIRN_CONTENT_SOURCE=api
