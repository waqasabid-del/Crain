# CAIRN configuration.
#
#   cp .env.example .env
#
# The values below are safe for local development and match docker-compose.yml.
# Nothing here may be used by an environment that holds customer data.
#
# See md/06-infrastructure.md §7 for how these are supplied in production.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# local | test | staging | production
#
# Read by migrations as well as the application. Anything other than "local"
# makes the migrations refuse to fall back to the development password below.
CAIRN_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The application connection. Must be a NOSUPERUSER, NOBYPASSRLS role, or every
# row-level security policy is silently inert — a startup preflight check
# refuses to boot if it is not (apps/api/src/cairn_api/db/preflight.py).
CAIRN_DATABASE_URL=postgresql+asyncpg://cairn_app:cairn_local_dev@localhost:5432/cairn

# The privileged connection, used only for operations that precede any tenant
# context: signup, workspace creation, invitation acceptance, and migrations.
#
# Must hold BYPASSRLS. Every table is FORCE ROW LEVEL SECURITY, so a role
# without it reads nothing at all — presenting as "no such user" for every
# account rather than as an error.
CAIRN_PLATFORM_DATABASE_URL=postgresql+asyncpg://cairn:cairn_local_dev@localhost:5432/cairn

# Echo SQL to the log. Never enable outside local development — it writes
# customer data into log storage.
CAIRN_DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Migration-time only
# ---------------------------------------------------------------------------
# Password for the cairn_app role, set when migrations create or repair it.
#
# REQUIRED whenever CAIRN_ENVIRONMENT is not "local" — the migration raises
# rather than falling back, because an earlier version hardcoded the value below
# and would have created production roles with a credential published in this
# repository. Supply it from Secret Manager.
# CAIRN_APP_ROLE_PASSWORD=

# Which role receives BYPASSRLS. Defaults to the username in
# CAIRN_PLATFORM_DATABASE_URL, which is almost always what you want. Set this
# only if the two genuinely differ.
# CAIRN_PLATFORM_ROLE=
